// Prisma schema for the Privello platform.
//
// Reflects the data models documented in
// .kiro/specs/privello-platform/design.md (section "Data Models").
// Snake_case is used for the underlying PostgreSQL tables/columns; the
// PascalCase model names are exposed to the application via Prisma Client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserType {
  CLIENTE
  ACOMPANHANTE
}

enum PlanoTipo {
  BASICO
  PREMIUM
}

enum PlanoClienteTipo {
  GRATIS
  FAN
}

enum MediaStatus {
  COMMITTED
  PENDING_REPAIR
  DELETED
  ARCHIVED
}

enum MediaKind {
  PHOTO
  VIDEO
  AUDIO
}

enum MediaRole {
  PROFILE
  COVER
  AUDIO
  /// Áudio curto (≤30s) respondendo a uma pergunta comum
  /// (TopicAudioKind). Diferente de `AUDIO` (que é o
  /// Áudio_de_Apresentação único, ≤60s). Filtra por
  /// `topicKind` na leitura.
  TOPIC_AUDIO
  /// Vídeo de apresentação (≤60s) — exclusivo do Plano_Premium.
  /// Slot único no perfil; ID em `acompanhante_profiles.video_apresentacao_id`.
  VIDEO_PRESENTATION
  GALLERY
  STORY
  REEL
}

/// Categoria do áudio curto por tópico (T07). Conjunto fechado
/// pra a UI mostrar uma lista pré-definida de "perguntas
/// frequentes" que cada Acompanhante pode responder com voz.
enum TopicAudioKind {
  /// Preço / valores praticados.
  PRECO
  /// Atende casal? duo? trio?
  CASAL
  /// Disponibilidade / dias / horários.
  DISPONIBILIDADE
  /// Local de atendimento (com ou sem local).
  LOCAL
  /// Práticas / o que faz e o que não faz.
  PRATICAS
  /// Forma de pagamento aceita.
  PAGAMENTO
}

enum BoostPaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

enum VerificationStatus {
  PENDENTE
  APROVADA
  REJEITADA
}

/// Origem de uma visualização de perfil público (T10 — stats
/// avançados). Classificada server-side a partir do referrer.
enum ViewOrigin {
  /// Veio da página de busca (`/acompanhantes?...`).
  BUSCA
  /// Veio da home (`/`).
  HOME
  /// Acesso direto — sem referrer interno (link colado, app, etc).
  DIRECT
  /// Veio de fora do domínio (rede social, WhatsApp, Google).
  COMPARTILHADO
}

enum ReportTargetType {
  USER
  MEDIA
  COMMENT
  REVIEW
}

enum ReportMotivo {
  CONTEUDO_FALSO
  MENOR_DE_IDADE
  ASSEDIO
  GOLPE
  SPAM
  OUTRO
}

enum ReportStatus {
  PENDENTE
  RESOLVIDA
  DESCARTADA
}

enum Etnia {
  BRANCA
  NEGRA
  PARDA
  AMARELA
  INDIGENA
}

enum CorOlhos {
  CASTANHO
  PRETO
  AZUL
  VERDE
  MEL
  CINZA
}

enum EstiloCabelo {
  LISO
  ONDULADO
  CACHEADO
  CRESPO
}

enum TamanhoCabelo {
  CURTO
  MEDIO
  LONGO
}

enum Idioma {
  PORTUGUES
  INGLES
  ESPANHOL
  FRANCES
  ITALIANO
  ALEMAO
  OUTRO
}

enum Genero {
  MULHER
  HOMEM
  TRANS
}

enum Atende {
  MULHER
  HOMEM
  CASAL
  TRANS
}

enum Pratica {
  ORAL
  VAGINAL
  ANAL
  BEIJO_NA_BOCA
  MASSAGEM
  FETICHE
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  TRANSFERENCIA
}

/// Tipo de uma notificação in-site (V2). Conjunto fechado pra a UI
/// renderizar ícone/título por categoria sem parsear texto livre.
/// O detalhe específico (quem avaliou, qual o motivo da rejeição,
/// etc.) vive no campo `payload` (JSON).
enum NotificationType {
  /// Uma nova avaliação foi recebida.
  NOVA_AVALIACAO
  /// Um Cliente marcou o perfil como favorito.
  NOVO_FAVORITO
  /// Pedido de verificação aprovado pelo admin.
  VERIFICACAO_APROVADA
  /// Pedido de verificação rejeitado pelo admin.
  VERIFICACAO_REJEITADA
  /// Boost foi ativado (imediato ou agendado).
  BOOST_ATIVADO
  /// Surgiu um perfil novo que casa com uma busca salva do Cliente (V3).
  BUSCA_NOVA_CORRESPONDENCIA
  /// Resumo semanal de atividade do perfil da Acompanhante (W3).
  RESUMO_SEMANAL
}

enum DiaSemana {
  SEG
  TER
  QUA
  QUI
  SEX
  SAB
  DOM
}

// ---------------------------------------------------------------------------
// Core identity
// ---------------------------------------------------------------------------

/// Conta de Cliente ou Acompanhante. `email` e `identificador` são sempre
/// armazenados em caixa baixa para garantir a unicidade case-insensitive
/// exigida pelos requisitos 2.3 e 2.4.
model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  identificador String   @unique
  nome          String
  passwordHash  String   @map("password_hash")
  type          UserType
  /// Quando `true`, tem acesso ao painel `/admin` (moderação de
  /// denúncias e verificações). Sem RBAC granular no MVP — admin
  /// é admin total. Padrão `false`.
  isAdmin       Boolean  @default(false) @map("is_admin")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  acompanhante  AcompanhanteProfile?
  client        ClientProfile?
  sessions      Session[]
  medias        Media[]
  loginAttempts LoginAttempt[]
  passwordResetTokens PasswordResetToken[]
  boostPayments BoostPayment[]
  reviewsReceived AcompanhanteReview[] @relation("ReviewTarget")
  reviewsAuthored AcompanhanteReview[] @relation("ReviewAuthor")
  questionsReceived AcompanhanteQuestion[] @relation("QuestionTarget")
  questionsAuthored AcompanhanteQuestion[] @relation("QuestionAuthor")
  mediaLikes      MediaLike[]
  mediaComments   MediaComment[]
  storyViews      StoryView[]
  reelViews       ReelView[]
  profileDailyStats ProfileDailyStat[]
  profileHourlyStats ProfileHourlyStat[]
  profileOriginStats ProfileOriginStat[]
  verification    Verification?
  verificationsReviewed Verification[] @relation("VerificationReviewer")
  reportsAuthored Report[] @relation("ReportAuthor")
  reportsResolved Report[] @relation("ReportResolver")
  /// Favoritos onde este User é o Cliente que marcou.
  favoritesAuthored ClientFavorite[] @relation("ClientFavoritesAuthor")
  /// Favoritos onde este User é a Acompanhante marcada.
  favoritedBy       ClientFavorite[] @relation("ClientFavoritesTarget")
  /// Notificações in-site endereçadas a este User (V2).
  notifications     Notification[]
  /// Buscas salvas pelo Cliente (V3).
  savedSearches     SavedSearch[]

  @@index([isAdmin])
  @@map("users")
}

model ClientProfile {
  userId             String            @id @map("user_id") @db.Uuid
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  fotoPerfilId       String?           @unique @map("foto_perfil_id") @db.Uuid
  fotoPerfil         Media?            @relation("ClientFotoDePerfil", fields: [fotoPerfilId], references: [id])
  planoVigente       PlanoClienteTipo? @map("plano_vigente")
  planoSelecionadoEm DateTime?         @map("plano_selecionado_em")
  /// Quando o plano vigente expira. `NULL` para `GRATIS` (perpétuo)
  /// ou enquanto o Cliente ainda não escolheu plano. Para `FAN`,
  /// é a data de fim do benefício comprado (24h, 7d ou 30d).
  /// Quando `now() > planoExpiraEm`, o Cliente é tratado como
  /// `GRATIS` (downgrade lazy no read).
  planoExpiraEm      DateTime?         @map("plano_expira_em")

  @@map("client_profiles")
}

/// Perfil de Acompanhante criado ao final do onboarding. `planoVigente` é
/// `NULL` enquanto a Acompanhante ainda não confirmou um plano em
/// `/selecao-plano` (Requirements 5.4, 5.5 e 5.10).
model AcompanhanteProfile {
  userId             String     @id @map("user_id") @db.Uuid
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  telefone           String
  estadoSigla        String     @map("estado_sigla") @db.VarChar(2)
  cidadeNome         String     @map("cidade_nome")
  bairroNome         String?    @map("bairro_nome")
  descricao          String     @db.VarChar(1000)
  fotoPerfilId       String?    @unique @map("foto_perfil_id") @db.Uuid
  fotoPerfil         Media?     @relation("FotoDePerfil", fields: [fotoPerfilId], references: [id])
  capaPerfilId       String?    @unique @map("capa_perfil_id") @db.Uuid
  capaPerfil         Media?     @relation("CapaDePerfil", fields: [capaPerfilId], references: [id])
  audioApresentacaoId String?   @unique @map("audio_apresentacao_id") @db.Uuid
  audioApresentacao  Media?     @relation("AudioDeApresentacao", fields: [audioApresentacaoId], references: [id])
  /// Vídeo de apresentação (≤60s) — exclusivo do Plano_Premium.
  /// Mostrado em destaque no perfil público. Slot único: gravar
  /// novamente substitui (não acumula). Distinto do REEL (que é
  /// um conjunto de N vídeos curtos) e da galeria.
  videoApresentacaoId String?   @unique @map("video_apresentacao_id") @db.Uuid
  videoApresentacao  Media?     @relation("VideoDeApresentacao", fields: [videoApresentacaoId], references: [id])
  planoVigente       PlanoTipo? @map("plano_vigente")
  planoSelecionadoEm DateTime?  @map("plano_selecionado_em")

  // Características físicas e perfil — todos opcionais. Coletados de
  // forma enxuta no Onboarding_Acompanhante (step "Aparência") e
  // editáveis a qualquer momento no painel.
  genero             Genero?
  pesoKg             Int?           @map("peso_kg")
  alturaCm           Int?           @map("altura_cm")
  tamanhoPe          Int?           @map("tamanho_pe")
  etnia              Etnia?
  corOlhos           CorOlhos?      @map("cor_olhos")
  estiloCabelo       EstiloCabelo?  @map("estilo_cabelo")
  tamanhoCabelo      TamanhoCabelo? @map("tamanho_cabelo")
  temSilicone        Boolean?       @map("tem_silicone")
  temTatuagens       Boolean?       @map("tem_tatuagens")
  temPiercing        Boolean?       @map("tem_piercing")
  fumante            Boolean?
  idiomas            Idioma[]       @default([])
  atendePublicos     Atende[]       @default([]) @map("atende_publicos")
  realizaPraticas    Pratica[]      @default([]) @map("realiza_praticas")

  // Atendimento comercial: valor da hora (em centavos), formas de
  // pagamento aceitas e dias da semana em que atende. Coletados de
  // forma enxuta no Onboarding e editáveis no painel.
  valorHoraCents     Int?              @map("valor_hora_cents")
  formasPagamento    FormaPagamento[]  @default([]) @map("formas_pagamento")
  diasAtende         DiaSemana[]       @default([]) @map("dias_atende")

  // Toggle de visibilidade pública. `true` (default) faz o perfil
  // aparecer nas buscas e o `/acompanhantes/[slug]` mostrar tudo.
  // `false` faz a busca ignorá-la e o slug renderizar a tela
  // genérica de "perfil oculto ou desativado". Mesmo estado
  // visual usado quando `planoVigente` é nulo (plano expirado).
  perfilVisivel      Boolean        @default(true) @map("perfil_visivel")

  // Janela ativa do Boost (promoção paga de 24h que dá prioridade
  // total em buscas e destaque na home). `NULL` ou no passado =
  // sem boost. Setado pelo webhook do Mercado Pago via
  // `processarWebhookBoost`.
  boostUntil         DateTime?      @map("boost_until")

  // Contador agregado de visualizações públicas. Incrementado por
  // `incrementarVisualizacao` no acesso ao perfil público, com
  // cooldown via cookie por viewer. Substituível por agregação
  // baseada em eventos quando o `Sistema_de_Estatisticas` existir.
  viewsCount         Int            @default(0) @map("views_count")

  // Contador agregado de cliques no botão de WhatsApp. Alimenta a
  // métrica de conversão (visualização → clique) no painel.
  whatsappClicksCount Int           @default(0) @map("whatsapp_clicks_count")

  // Coordenadas aproximadas (centroide do bairro/cidade + jitter)
  // pra exibir no mapa da busca (T14). NUNCA é endereço exato —
  // geocodificado via Nominatim a partir de (cidade, UF[, bairro])
  // ao salvar a localização, com ruído pra preservar privacidade.
  // `null` quando ainda não geocodificado.
  lat                Float?         @map("lat") @db.DoublePrecision
  lng                Float?         @map("lng") @db.DoublePrecision

  // Contador de avaliações (apenas comentários textuais — nota
  // foi removida do produto). Materializado pela trigger
  // `trg_reviews_agregado` em INSERT/DELETE de
  // `acompanhante_reviews`.
  reviewsCount       Int            @default(0) @map("reviews_count")

  /// Mirror do estado da última verificação aprovada. Quando
  /// `true`, o badge "Verificada" aparece no perfil público e
  /// nos cards. Atualizado pelo serviço de verificação ao aprovar/
  /// rejeitar — não é trigger SQL pra simplificar (single source
  /// of truth: o admin escreve; ninguém mais toca). Default
  /// `false`.
  verificada         Boolean        @default(false)

  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  @@index([perfilVisivel, planoVigente])
  @@index([boostUntil])
  @@index([estadoSigla, cidadeNome])
  @@index([viewsCount(sort: Desc), updatedAt(sort: Desc)])
  @@index([updatedAt(sort: Desc)])
  @@map("acompanhante_profiles")
}

// ---------------------------------------------------------------------------
// Mídia (R2)
// ---------------------------------------------------------------------------

model Media {
  id             String      @id @default(uuid()) @db.Uuid
  ownerId        String      @map("owner_id") @db.Uuid
  owner          User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  storageKey     String      @unique @map("storage_key")
  mimeType       String      @map("mime_type")
  sizeBytes      Int         @map("size_bytes")
  status         MediaStatus
  kind           MediaKind   @default(PHOTO)
  role           MediaRole   @default(GALLERY)
  description    String?
  /// @deprecated — use `role` em vez disso. Mantido por compat até
  /// uma migration de cleanup remover.
  isProfilePhoto Boolean     @default(false) @map("is_profile_photo")

  // Agregados de interação. Atualizados via triggers no banco
  // (`trg_media_likes_agg`, `trg_media_comments_agg`) sempre que
  // `media_likes` / `media_comments` mudam.
  likesCount     Int         @default(0) @map("likes_count")
  commentsCount  Int         @default(0) @map("comments_count")

  // Para Stories, momento em que a mídia expira (default: 24h após
  // o `createdAt`). Para outros `role`s fica `NULL`. A varredura
  // periódica (cron lazy) muda `status` para `DELETED` quando
  // `expires_at <= now()`. Stories também não aparecem em queries
  // de leitura quando expirados — filtro `expiresAt > now()` é
  // aplicado no read.
  expiresAt      DateTime?   @map("expires_at")

  // Para Reels (vídeos), duração em segundos. Validada no upload
  // entre 15 e 90s. Outros `role`s ignoram.
  durationSeconds Int?       @map("duration_seconds")
  // Para Reels (vídeos), chave do poster estático (primeiro frame
  // extraído com ffmpeg) — evita tela preta enquanto o vídeo
  // carrega. Outros `role`s ignoram.
  posterStorageKey String?   @map("poster_storage_key")

  /// Ordem manual da galeria (apenas `role=GALLERY`). Quanto menor,
  /// mais à frente. Em queries de leitura ordenamos por `sort_order
  /// asc, created_at desc` — itens que nunca foram reordenados ficam
  /// em `0` e caem no tiebreaker por `createdAt` (preserva o
  /// comportamento atual quando ninguém arrastou nada).
  sortOrder      Int         @default(0) @map("sort_order")

  /// Título do destaque (Highlights estilo Instagram) ao qual este
  /// Story arquivado pertence. `NULL` = não está em nenhum destaque.
  /// Apenas Stories arquivados (`role=STORY` e `status=ARCHIVED`)
  /// podem ser tagueados — fora isso o campo é ignorado.
  highlightTitle String?     @map("highlight_title")
  /// Ordem dentro do mesmo destaque (`highlight_title`). Default 0.
  /// Em queries de leitura ordenamos por `highlight_order asc,
  /// created_at desc`.
  highlightOrder Int?        @map("highlight_order")

  /// Categoria do áudio curto por tópico (apenas quando
  /// `role=TOPIC_AUDIO`). NULL pra outros roles. Cada User pode ter
  /// no máximo 1 TopicAudio por `topicKind` — unique parcial garante.
  topicKind      TopicAudioKind? @map("topic_kind")

  createdAt      DateTime    @default(now()) @map("created_at")

  acompanhanteAsProfile AcompanhanteProfile? @relation("FotoDePerfil")
  acompanhanteAsCover   AcompanhanteProfile? @relation("CapaDePerfil")
  acompanhanteAsAudio   AcompanhanteProfile? @relation("AudioDeApresentacao")
  acompanhanteAsVideo   AcompanhanteProfile? @relation("VideoDeApresentacao")
  clientAsProfile       ClientProfile?       @relation("ClientFotoDePerfil")

  likes    MediaLike[]
  comments MediaComment[]
  storyViews StoryView[]
  reelViews ReelView[]

  @@index([ownerId])
  @@index([ownerId, role, status, createdAt(sort: Desc)])
  @@index([role, status, expiresAt])
  @@map("medias")
}

/// Curtida em uma `Media`. Restrição UNIQUE em `(media_id, user_id)`
/// garante 1 curtida por par. Trigger no banco recalcula
/// `likes_count` em `medias` no INSERT/DELETE.
model MediaLike {
  mediaId   String   @map("media_id") @db.Uuid
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([mediaId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("media_likes")
}

/// Visualização de Story por um viewer autenticado. 1 por par
/// `(media, user)` — visualizar o mesmo Story duas vezes não cria
/// nova linha. Usado para colorir o ring do avatar no perfil
/// público (azul/colorido = não visto, cinza = visto).
///
/// Não tem trigger de agregado — a contagem de "viewers únicos"
/// quando precisar é uma `count()` direta.
model StoryView {
  mediaId   String   @map("media_id") @db.Uuid
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now()) @map("viewed_at")

  @@id([mediaId, userId])
  @@index([userId, viewedAt(sort: Desc)])
  @@map("story_views")
}

/// Visualização de Reel por um viewer autenticado. Mesmo modelo de
/// StoryView, mas separado pra que o algoritmo de feed possa
/// priorizar não-vistos sem cruzar com Stories.
///
/// Também alimenta a quota diária de visualizações pra anônimos
/// e não-Fans (limite na contagem dos últimos 24h).
model ReelView {
  mediaId   String   @map("media_id") @db.Uuid
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now()) @map("viewed_at")

  @@id([mediaId, userId])
  @@index([userId, viewedAt(sort: Desc)])
  @@map("reel_views")
}

/// Comentário em uma `Media`. N por par `(media, user)` (Cliente
/// pode comentar várias vezes). Trigger recalcula `comments_count`.
model MediaComment {
  id           String   @id @default(uuid()) @db.Uuid
  mediaId      String   @map("media_id") @db.Uuid
  media        Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  authorUserId String   @map("author_user_id") @db.Uuid
  author       User     @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  text         String   @db.VarChar(2000)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([mediaId, createdAt(sort: Desc)])
  @@index([authorUserId, createdAt(sort: Desc)])
  @@map("media_comments")
}

// ---------------------------------------------------------------------------
// Sessões e tentativas de login
// ---------------------------------------------------------------------------

/// Sessão autenticada. `expiresAt` é estritamente menor ou igual a
/// `createdAt + 30 dias` (Requirement 1.1) e `revokedAt` registra o
/// instante do logout (Requirement 1.5).
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Histórico de tentativas de login utilizado para o rate limit por email
/// (Requirement 1.8). Mantido mesmo após a sessão ser criada para manter a
/// janela deslizante de 15 minutos.
model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  success   Boolean
  userId    String?  @map("user_id") @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("login_attempts")
}

/// Token de reset de senha. Cada usuário pode ter múltiplos tokens
/// pendentes — todos viram inválidos quando um deles é consumido,
/// e todos expiram passados 60 minutos do `createdAt`.
///
/// Armazena hash SHA-256 do token (em hex) no campo `tokenHash`,
/// nunca o valor original — quem comprometer o banco não consegue
/// usar tokens em aberto. O cliente recebe o valor original via
/// email (a integração de envio é o próximo passo).
///
/// `usedAt` é gravado quando o token é consumido com sucesso pelo
/// endpoint de troca de senha. Tokens com `usedAt != NULL` ou
/// `expiresAt <= now()` são rejeitados.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Estatísticas diárias por perfil de Acompanhante.
///
/// Uma linha por dia. `day` é a meia-noite UTC do dia. Atualizadas
/// pela função `incrementarStatDiaria` ao registrar visualização
/// ou curtida. Permite o painel mostrar um gráfico dos últimos
/// 30 dias sem agregar `MediaLike` / `views` na renderização.
model ProfileDailyStat {
  userId String   @map("user_id") @db.Uuid
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    DateTime @map("day") @db.Date
  views  Int      @default(0)
  likes  Int      @default(0)
  /// Cliques no botão de WhatsApp neste dia. Alimenta a métrica de
  /// conversão (visualização → clique) no painel.
  whatsappClicks Int @default(0) @map("whatsapp_clicks")

  @@id([userId, day])
  @@index([userId, day(sort: Desc)])
  @@map("profile_daily_stats")
}

/// Stats avançados (T10) — agregação por dia-da-semana × hora (UTC)
/// pra alimentar um heatmap 7×24 de "quando recebo visitas". Uma
/// linha por (userId, weekday, hour). `weekday` 0=domingo..6=sábado
/// (igual a `Date.getUTCDay()`). `hour` 0..23 em UTC.
///
/// Mantida separada da daily pra que o heatmap não precise de uma
/// tabela por-hora-por-dia (que cresceria sem limite). Aqui o
/// espaço é fixo: no máximo 7×24=168 linhas por perfil.
model ProfileHourlyStat {
  userId  String @map("user_id") @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekday Int    @map("weekday")
  hour    Int    @map("hour")
  views   Int    @default(0)

  @@id([userId, weekday, hour])
  @@map("profile_hourly_stats")
}

/// Stats avançados (T10) — agregação de visualizações por origem.
/// Uma linha por (userId, origin). Cresce no máximo 4 linhas por
/// perfil (uma por valor do enum `ViewOrigin`).
model ProfileOriginStat {
  userId String     @map("user_id") @db.Uuid
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  origin ViewOrigin
  views  Int        @default(0)

  @@id([userId, origin])
  @@map("profile_origin_stats")
}

// ---------------------------------------------------------------------------
// Onboarding draft
// ---------------------------------------------------------------------------

/// Estado parcial do Onboarding_Acompanhante mantido entre etapas. O cookie
/// `onboardingId` aponta para esta linha. `expiresAt` é igual a
/// `updatedAt + 60 minutos` e drafts expirados são apagados junto com o
/// objeto staged em R2 (Requirements 3.3 e 3.4).
model OnboardingDraft {
  id        String   @id @default(uuid()) @db.Uuid
  payload   Json
  stagedKey String?  @map("staged_key")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("onboarding_drafts")
}

// ---------------------------------------------------------------------------
// Cache do IBGE
// ---------------------------------------------------------------------------

/// Cache local dos resultados da API do IBGE. `expiresAt - fetchedAt` está
/// sempre em `[24h, 7 dias]` (Requirement 4.5).
model IbgeCacheEntry {
  key       String   @id
  payload   Json
  fetchedAt DateTime @default(now()) @map("fetched_at")
  expiresAt DateTime @map("expires_at")

  @@map("ibge_cache")
}

// ---------------------------------------------------------------------------
// Boost (promoção paga de 24h)
// ---------------------------------------------------------------------------

/// Registro de uma compra de Boost da Acompanhante.
///
/// Boost é uma promoção de 24h que dá prioridade total em buscas e
/// destaque na home. Cada compra cria um `BoostPayment` em `PENDING`
/// e uma `Preference` correspondente no Mercado Pago. O webhook do
/// MP confirma a aprovação via `processarWebhookBoost`, que atualiza
/// `status` para `APPROVED` e estende `AcompanhanteProfile.boostUntil`
/// em +24h.
///
/// Idempotência: `externalReference` é único e enviado ao MP como
/// `external_reference` da preference. Webhooks duplicados são
/// detectados comparando `mp_payment_id` antes de aplicar a janela.
model BoostPayment {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents        Int                @map("amount_cents")
  currency           String             @default("BRL") @db.VarChar(3)
  status             BoostPaymentStatus @default(PENDING)
  externalReference  String             @unique @map("external_reference") @db.VarChar(80)
  mpPreferenceId     String?            @unique @map("mp_preference_id") @db.VarChar(120)
  mpPaymentId        String?            @map("mp_payment_id") @db.VarChar(120)
  /// Momento em que o boost deve COMEÇAR. `NULL` = imediato (ativa
  /// assim que o pagamento é aprovado). Quando preenchido e no
  /// futuro, o webhook aprova o pagamento mas NÃO estende
  /// `boostUntil` — o cron noturno (`ativarBoostsAgendados`) faz a
  /// ativação quando `startAt <= now`. A flag de idempotência é
  /// `activatesAt IS NULL` (só ativa quem ainda não foi ativado).
  startAt            DateTime?          @map("start_at")
  activatesAt        DateTime?          @map("activates_at")
  expiresAt          DateTime?          @map("expires_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([status, activatesAt, startAt])
  @@map("boost_payments")
}

/// Avaliação pública deixada por um Cliente em um perfil de
/// Acompanhante. É **apenas texto livre** (sem nota numérica).
/// Cada par `(targetUserId, authorUserId)` é único — um Cliente
/// só avalia uma Acompanhante uma vez. Reedição vira UPSERT.
///
/// O agregado `reviews_count` em `acompanhante_profiles` é
/// atualizado via trigger `trg_reviews_agregado` no INSERT/DELETE
/// pra garantir consistência sem depender da aplicação.
model AcompanhanteReview {
  id           String   @id @default(uuid()) @db.Uuid
  targetUserId String   @map("target_user_id") @db.Uuid
  target       User     @relation("ReviewTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  authorUserId String   @map("author_user_id") @db.Uuid
  author       User     @relation("ReviewAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  comment      String   @db.VarChar(2000)
  /// Nota numérica de 1 a 5 (opcional). Cliente pode avaliar sem
  /// dar nota. Quando dá, alimenta a "nota geral" exposta atrás de
  /// gate Fan no perfil. Constraint no banco garante range.
  rating       Int?
  /// Resposta da Acompanhante à avaliação. `null` quando ainda
  /// não respondeu. Acompanhante pode editar livremente.
  replyText    String?  @db.VarChar(2000) @map("reply_text")
  /// Quando a Acompanhante respondeu pela primeira vez. Editar
  /// não atualiza, apenas a primeira resposta.
  repliedAt    DateTime? @map("replied_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([targetUserId, authorUserId])
  @@index([targetUserId, createdAt(sort: Desc)])
  @@map("acompanhante_reviews")
}

/// Perguntas e respostas (Q&A) públicas no perfil de uma
/// Acompanhante. Apenas Cliente Fan pode perguntar e ver
/// perguntas/respostas. Acompanhante (dona do perfil) responde no
/// próprio painel. Resposta sobrescreve em UPDATE — uma pergunta
/// tem 0 ou 1 resposta.
///
/// Por que **não** permitir várias respostas: simplifica a UX e
/// não vimos caso real de necessitar múltiplas. Caso surja, vira
/// tabela `question_answers` com chave composta.
model AcompanhanteQuestion {
  id           String   @id @default(uuid()) @db.Uuid
  targetUserId String   @map("target_user_id") @db.Uuid
  target       User     @relation("QuestionTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  authorUserId String   @map("author_user_id") @db.Uuid
  author       User     @relation("QuestionAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  question     String   @db.VarChar(500)
  /// Resposta da Acompanhante. `NULL` enquanto pendente.
  answer       String?  @db.VarChar(2000)
  /// Quando a Acompanhante respondeu pela primeira vez. Editar a
  /// resposta atualiza o `updatedAt` mas não o `answeredAt`.
  answeredAt   DateTime? @map("answered_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([targetUserId, createdAt(sort: Desc)])
  @@index([targetUserId, answeredAt])
  @@map("acompanhante_questions")
}


// ---------------------------------------------------------------------------
// Verificação de identidade da Acompanhante
// ---------------------------------------------------------------------------

/// Pedido de verificação de identidade enviado pela Acompanhante.
/// Cada Acompanhante tem 0 ou 1 verificação (constraint unique).
/// Reenvio sobrescreve a anterior.
///
/// Quando o admin aprova, o serviço também atualiza
/// `AcompanhanteProfile.verificada = true` (mirror barato pra UI
/// não precisar de join). Quando rejeita, mantém `verificada =
/// false` e grava `motivoRejeicao`.
model Verification {
  id                  String              @id @default(uuid()) @db.Uuid
  userId              String              @unique @map("user_id") @db.Uuid
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  selfieStorageKey    String              @map("selfie_storage_key")
  documentoStorageKey String              @map("documento_storage_key")
  status              VerificationStatus  @default(PENDENTE)
  motivoRejeicao      String?             @db.VarChar(500) @map("motivo_rejeicao")
  submetidaEm         DateTime            @default(now()) @map("submetida_em")
  revisadaEm          DateTime?           @map("revisada_em")
  revisadaPorUserId   String?             @map("revisada_por_user_id") @db.Uuid
  revisadaPor         User?               @relation("VerificationReviewer", fields: [revisadaPorUserId], references: [id], onDelete: SetNull)
  /// Quando a verificação aprovada deixa de valer. Set ao
  /// `revisadaEm + 180 dias` no `aprovarVerificacao`. NULL pra
  /// PENDENTE/REJEITADA. Cleanup noturno rebaixa
  /// `acompanhante_profiles.verificada` quando `expira_em < now()`.
  expiraEm            DateTime?           @map("expira_em")

  // Index parcial em (expira_em) WHERE status='APROVADA' AND
  // expira_em IS NOT NULL — declarado em SQL na migration
  // 20260721000000_verification_expiry porque Prisma DSL não
  // suporta partial indexes.
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Sistema de denúncias
// ---------------------------------------------------------------------------

/// Denúncia feita por um usuário contra outro perfil, mídia,
/// comentário ou avaliação. Múltiplas denúncias do mesmo alvo
/// geram múltiplas linhas — admin trata uma de cada vez.
///
/// `targetId` é o id do alvo, mas a relação é polimórfica via
/// `targetType` — Prisma não suporta polimorfismo direto, então
/// não declaramos FK. Caller é responsável por validar que o
/// `targetId` existe no momento da criação.
model Report {
  id                  String           @id @default(uuid()) @db.Uuid
  reporterUserId      String           @map("reporter_user_id") @db.Uuid
  reporter            User             @relation("ReportAuthor", fields: [reporterUserId], references: [id], onDelete: Cascade)
  targetType          ReportTargetType @map("target_type")
  targetId            String           @map("target_id") @db.Uuid
  motivo              ReportMotivo
  descricao           String?          @db.VarChar(2000)
  status              ReportStatus     @default(PENDENTE)
  resolucao           String?          @db.VarChar(500)
  criadaEm            DateTime         @default(now()) @map("criada_em")
  resolvidaEm         DateTime?        @map("resolvida_em")
  resolvidaPorUserId  String?          @map("resolvida_por_user_id") @db.Uuid
  resolvidaPor        User?            @relation("ReportResolver", fields: [resolvidaPorUserId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId, criadaEm(sort: Desc)])
  @@index([reporterUserId, criadaEm(sort: Desc)])
  // Unique parcial em (reporterUserId, targetType, targetId)
  // WHERE status = 'PENDENTE' — declarado em SQL puro pela
  // migration `20260720000000_report_unique_reporter_target`
  // porque Prisma DSL não suporta partial indexes.
  @@map("reports")
}


// ---------------------------------------------------------------------------
// Favoritos / Salvos
// ---------------------------------------------------------------------------

/// Marcação leve de "Cliente favoritou Acompanhante". Toggle
/// idempotente (PK composta evita duplicata). Cada Cliente vê a
/// própria lista; cada Acompanhante vê apenas o COUNT total
/// (anonimizado — quem é cada favorito é privado).
model ClientFavorite {
  clientUserId        String   @map("client_user_id") @db.Uuid
  client              User     @relation("ClientFavoritesAuthor", fields: [clientUserId], references: [id], onDelete: Cascade)
  acompanhanteUserId  String   @map("acompanhante_user_id") @db.Uuid
  acompanhante        User     @relation("ClientFavoritesTarget", fields: [acompanhanteUserId], references: [id], onDelete: Cascade)
  criadoEm            DateTime @default(now()) @map("criado_em")

  @@id([clientUserId, acompanhanteUserId])
  @@index([clientUserId, criadoEm(sort: Desc)])
  @@index([acompanhanteUserId])
  @@map("client_favorites")
}

// ---------------------------------------------------------------------------
// Notificações in-site
// ---------------------------------------------------------------------------

/// Notificação in-site endereçada a um User (V2). Tudo no site —
/// nunca por email. Gerada por eventos: nova avaliação, novo
/// favorito, verificação aprovada/rejeitada, boost ativado.
///
/// O `type` define a categoria (ícone/título na UI); `payload`
/// guarda o detalhe específico em JSON (ex.: `{ "autorNome": "..." }`
/// ou `{ "motivo": "..." }`). `lidaEm` nulo = não lida; o sininho
/// conta as não lidas.
///
/// Cascade: deletar o User destinatário limpa as notificações.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  payload   Json
  lidaEm    DateTime?        @map("lida_em")
  criadoEm  DateTime         @default(now()) @map("criado_em")

  // Lookup "minhas notificações" (ordem desc) + contagem de não
  // lidas (filtra lidaEm IS NULL). O índice composto cobre ambos.
  @@index([userId, criadoEm(sort: Desc)])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Buscas salvas (Cliente)
// ---------------------------------------------------------------------------

/// Busca salva por um Cliente (V3): cidade + filtros serializados.
/// Quando um perfil novo passa a aparecer nas buscas (a Acompanhante
/// publica) e casa com os filtros salvos, o Cliente recebe uma
/// notificação in-site (reusa V2). `lastNotifiedAt` evita reenviar a
/// mesma correspondência repetidamente.
///
/// O `filtros` guarda o shape `BuscaFiltros` (JSON). `label` é um
/// rótulo amigável derivado da cidade/filtros, gerado no salvamento.
///
/// Cascade: deletar o Cliente limpa as buscas salvas.
model SavedSearch {
  id              String    @id @default(uuid()) @db.Uuid
  clientUserId    String    @map("client_user_id") @db.Uuid
  client          User      @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  label           String    @db.VarChar(160)
  filtros         Json
  /// Última vez que disparamos notificação por correspondência
  /// nova. Usado pelo matcher pra não notificar o mesmo perfil 2x.
  lastNotifiedAt  DateTime? @map("last_notified_at")
  criadoEm        DateTime  @default(now()) @map("criado_em")

  @@index([clientUserId, criadoEm(sort: Desc)])
  @@map("saved_searches")
}
