{
    "name": "privello",
    "version": "0.1.0",
    "private": true,
    "description": "Privello platform: cadastro/login de Clientes e Acompanhantes, onboarding e seleção de plano.",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "lint:primitives": "node --experimental-strip-types scripts/lint-primitives.ts",
        "test": "vitest --run",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:migrate:deploy": "prisma migrate deploy",
        "prisma:seed": "prisma db seed",
        "seed:admin": "tsx prisma/seed-admin.ts"
    },
    "prisma": {
        "schema": "prisma/schema.prisma",
        "seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.1051.0",
        "@aws-sdk/s3-request-presigner": "3.1051.0",
        "@node-rs/argon2": "^2.0.2",
        "@prisma/client": "^5.22.0",
        "ffmpeg-static": "^5.3.0",
        "maplibre-gl": "^4.7.1",
        "next": "15.5.18",
        "react": "19.0.0",
        "react-dom": "19.0.0",
        "sharp": "^0.34.5",
        "stripe": "^22.2.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "20.17.10",
        "@types/react": "19.0.7",
        "@types/react-dom": "19.0.3",
        "autoprefixer": "10.4.20",
        "eslint": "9.18.0",
        "eslint-config-next": "15.5.18",
        "fast-check": "^4.8.0",
        "jsdom": "^29.1.1",
        "msw": "^2.14.6",
        "postcss": "8.4.49",
        "prisma": "^5.22.0",
        "tailwindcss": "3.4.17",
        "tsx": "^4.22.3",
        "typescript": "5.7.3",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "2.1.8"
    }
}
